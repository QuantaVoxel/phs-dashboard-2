# ==========================================
# Better Auth Configuration
# ==========================================
# Generate a secret using: npx auth secret
BETTER_AUTH_SECRET="your-32-byte-secret-string-here"
# The base URL of your application (e.g. http://localhost:3000 for local dev)
BETTER_AUTH_URL="http://localhost:3000"

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/phs_dashboard"

# ==========================================
# Initial Admin Credentials (for seeding)
# ==========================================
# Used by setup scripts to create the first admin user
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="super-secure-password"
ADMIN_NAME="Master Admin"

# ==========================================
# Inngest Background Jobs (Production)
# ==========================================
# You can get these keys from your Inngest Cloud Dashboard
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# (Optional) For local development only:
# INNGEST_DEV=1
